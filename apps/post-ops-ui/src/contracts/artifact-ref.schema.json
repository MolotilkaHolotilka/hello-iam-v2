{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helloiam.am/schemas/artifact-ref.schema.json",
  "title": "ArtifactRef",
  "type": "object",
  "required": [
    "type",
    "path",
    "version",
    "checksum"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "copy",
        "storyboard",
        "manifest",
        "metadata"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "checksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
